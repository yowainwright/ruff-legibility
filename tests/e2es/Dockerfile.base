FROM rust:1.94-slim-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        python3 \
        python3-dev \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /source
COPY . .
RUN pip install --no-cache-dir .
ENV RUFF_LEGIBILITY_NATIVE=1
RUN python -c "from ruff_legibility import _native"
